# Copy this file to .env and fill in real values. Never commit .env.

# From https://discord.com/developers/applications → your app → Bot → Token
DISCORD_BOT_TOKEN=your-bot-token-here

# Enable Developer Mode in Discord, right-click the target channel → Copy ID
DISCORD_CHANNEL_ID=000000000000000000

# Optional: your server's ID (right-click the server name → Copy ID).
# If set, slash commands sync to that server instantly; otherwise they
# sync globally, which can take up to an hour to appear.
# DISCORD_GUILD_ID=000000000000000000

# Optional: how often to check, in hours (default 3)
# CHECK_INTERVAL_HOURS=3

# --- Web dashboard (dashboard_api.py) ---
# Optional: where the dashboard listens (defaults shown). Keep the host on
# 127.0.0.1 unless you understand the exposure — there is no login.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
# Optional: your Discord user ID — products added via the dashboard are
# attributed to this user, so in-stock pings mention you.
# DASHBOARD_USER_ID=000000000000000000
# DASHBOARD_USER_NAME=Dashboard
