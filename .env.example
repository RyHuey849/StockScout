# Copy this file to .env and fill in real values. Never commit .env.

# From https://discord.com/developers/applications → your app → Bot → Token
DISCORD_BOT_TOKEN=your-bot-token-here

# Enable Developer Mode in Discord, right-click the target channel → Copy ID
DISCORD_CHANNEL_ID=000000000000000000

# Optional: how often to check, in hours (default 3)
# CHECK_INTERVAL_HOURS=3
